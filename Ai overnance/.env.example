APP_NAME=ai-governance-gateway
ENV=dev
PORT=8000
LOG_LEVEL=INFO
GATEWAY_API_KEY=change-me
AUTH_MODE=either
JWT_SECRET=change-me-super-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=ai-governance
JWT_AUDIENCE=ai-governance-clients
UPSTREAM_LLM_URL=https://api.openai.com/v1/chat/completions
UPSTREAM_LLM_API_KEY=change-me
POLICY_DIR=./policies
REDIS_URL=redis://redis:6379/0
POSTGRES_DSN=postgresql://governance:governance@postgres:5432/governance
RATE_LIMIT_PER_MINUTE=120
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.3
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_SECONDS=30
AUDIT_QUEUE_MAXSIZE=10000
AUDIT_BATCH_SIZE=100
AUDIT_FLUSH_SECONDS=0.5
POLICY_HMAC_SECRET=
SEMANTIC_ENABLED_DEFAULT=true
SEMANTIC_MODE_DEFAULT=sync_gated
SEMANTIC_TIMEOUT_MS_DEFAULT=10
SEMANTIC_MIN_RISK_SCORE_DEFAULT=2
SEMANTIC_FAIL_MODE_DEFAULT=allow
SEMANTIC_MIN_CONFIDENCE_DEFAULT=0.80
SEMANTIC_ONNX_MODEL_PATH=./models/semantic_setfit_int8.onnx
SEMANTIC_TOKENIZER_PATH=./models/tokenizer.json
SEMANTIC_FASTTEXT_MODEL_PATH=./models/lid.176.ftz
SEMANTIC_MAX_LENGTH=128
SEMANTIC_LABELS=safe,unsafe
SEMANTIC_BLOCK_LABELS=unsafe,jailbreak,policy_bypass,data_exfil
SEMANTIC_LANGUAGE_ALLOWLIST=en,hi,mr,bn,ta,te,kn,ml,gu,pa,ur,hinglish
